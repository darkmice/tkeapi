# TokensByte 环境变量配置
# ──────────────────────────────────────────────────
# 项目名称配置 (可选，默认为当前目录名)
PROJECT_NAME=tokensbyte-ws

# 数据库连接 (二选一，解开注释即可)
# ──────────────────────────────────────────────────

# [1. 内置 PostgreSQL (默认，开箱即用)]
# DATABASE_URL=postgres://tokensapi:tokensapi@postgres:5432/tokensapi

# [2. 外部 PostgreSQL (RDS/云数据库)]
# DATABASE_URL=postgres://用户名:密码@数据库地址:5432/数据库名?sslmode=disable

# ──────────────────────────────────────────────────
# 内置 PostgreSQL 配置 (使用外部数据库时可忽略)
# ──────────────────────────────────────────────────
POSTGRES_USER=tokensapi
POSTGRES_PASSWORD=tokensapi
POSTGRES_DB=tokensapi

# ──────────────────────────────────────────────────
# 数据库连接池调优 (Web 8C16G + DB 4C4G 推荐 80/12s)
# ──────────────────────────────────────────────────
# 默认 80 连接；若部署在 2C4G 小内存机可调至 20~30
# DATABASE_MAX_CONNECTIONS=80
# DATABASE_ACQUIRE_TIMEOUT_SECS=12

# ──────────────────────────────────────────────────
# Docker 容器资源配额 (可选覆盖 docker-compose.yml 默认限制)
# ──────────────────────────────────────────────────
# BACKEND_MEM_LIMIT=12G
# BACKEND_MEM_RES=2G
# BACKEND_CPU_LIMIT=6.0
# BACKEND_CPU_RES=2.0
# FRONTEND_MEM_LIMIT=1024M
# FRONTEND_MEM_RES=256M
# FRONTEND_CPU_LIMIT=1.0
# FRONTEND_CPU_RES=0.25

# ──────────────────────────────────────────────────
# 安全配置 (生产环境务必修改)
# ──────────────────────────────────────────────────
# 使用命令 "openssl rand -hex 32" 生成强随机 JWT_SECRET（禁止使用默认示例值）
JWT_SECRET=tokensbyte-change-me

# 敏感配置加密存储密钥（AES-256-GCM，32字节Hex）。未配置时自动在数据目录生成并持久化。
# ENCRYPTION_KEY=your-32-bytes-hex-encryption-key

# 生产环境必须设置前端来源（逗号分隔）。未设置且非 development 时拒绝跨域。
# CORS_ORIGINS=https://your-frontend.example.com
# 本地 Vite 直连后端时可：
# APP_ENV=development
# 或 CORS_ORIGINS=http://localhost:5173

# 外部公开访问地址（生产环境推荐固定，防止 Host 头被恶意伪造）
# PUBLIC_API_URL=https://api.yourdomain.com       # 后端 API 公网地址（用于第三方支付异步通知、Vendor Callback 等）
# PUBLIC_FRONTEND_URL=https://www.yourdomain.com  # 前端 UI 公网地址（可选，默认自动从浏览器 Origin 感知；仅当前后端完全独立且需强行覆盖回跳地址时配置）

# ──────────────────────────────────────────────────
# 端口配置
# ──────────────────────────────────────────────────
BACKEND_PORT=3000
FRONTEND_PORT=8080
POSTGRES_PORT=5432

# ──────────────────────────────────────────────────
# 客户端最大请求体限制 (如上传素材的最大限制，默认 50m)
# ──────────────────────────────────────────────────
CLIENT_MAX_BODY_SIZE=50m

# ──────────────────────────────────────────────────
# 功能开关
# ──────────────────────────────────────────────────
REGISTER_ENABLED=true

# ──────────────────────────────────────────────────
# 运行模式（可选）
# ──────────────────────────────────────────────────
# 默认按生产：SIGTERM 时优雅关闭并 drain 计费管道
# 仅本地开发秒退时设置：APP_ENV=development 或 APP_ENV=dev
# APP_ENV=production

# ──────────────────────────────────────────────────
# 日志级别
# ──────────────────────────────────────────────────
RUST_LOG=info

# ──────────────────────────────────────────────────
# 数据目录 (存储图标、素材等静态文件)
# Docker 部署时由 docker-compose 自动设置，无需手动修改
# 本地开发时默认为 'data'（相对于后端工作目录）
# ──────────────────────────────────────────────────
# DATA_DIR=data

# ──────────────────────────────────────────────────
# 门户静态生成目录
# Docker 部署时如果需要挂载或共享，可自定义该目录
# 本地开发时默认为 '../frontend/dist/portal' (相对于后端工作目录)
# ──────────────────────────────────────────────────
# PORTAL_DIR=../frontend/dist/portal
# 站点门户增强版（商业插件）静态目录，与 PORTAL_DIR 隔离
# PORTAL_PRO_DIR=../frontend/dist/portal_pro

# ──────────────────────────────────────────────────
# 图标与素材发布目录
# Docker 部署时如果需要挂载或共享，可自定义该目录
# 本地开发时默认为 '../frontend/dist/assets' (相对于后端工作目录)
# ──────────────────────────────────────────────────
# ASSETS_DIR=../frontend/dist/assets

# ──────────────────────────────────────────────────
# 出站网络与 SSRF 防御 / 媒体流式配额
# ──────────────────────────────────────────────────
# 远程素材/图片下载单文件最大允许大小（单位 MB，默认 50，防止大文件耗尽内存导致 OOM）
# HTTP_MAX_DOWNLOAD_MB=50

# SSRF 私网放行开关（默认 false：严格阻断向 127/8、10/8、172.16/12、192.168/16、169.254/16 的探测）
# 仅当部署在完全隔离的离线局域网/纯私有内网机房环境时，才设置为 true
# SSRF_ALLOW_PRIVATE_IP=false

# 出站 HTTP 请求超时与连接池优化（秒）
# HTTP_DOWNLOAD_TIMEOUT_SECS=300
# HTTP_UPSTREAM_TIMEOUT_SECS=1800
# HTTP_CONNECT_TIMEOUT_SECS=10
# HTTP_TCP_KEEPALIVE_SECS=15
# HTTP_POOL_IDLE_TIMEOUT_SECS=45
# HTTP_POOL_MAX_IDLE_PER_HOST=100

# ──────────────────────────────────────────────────
# 高并发保护与集群拓扑（可选高级配置）
# ──────────────────────────────────────────────────
# 全局在途请求并发上限（超出立即快速拒载，保护后端不被瞬时打垮）
# MAX_IN_FLIGHT_REQUESTS=2000
# 多节点集群角色标识（master 或 worker，默认 master）
# NODE_ROLE=master
# 当前实例标识
# INSTANCE_NAME=tokensbyte-node-1



